import type { PageableResult } from "@rocketbase/commons-rest-client";
import type { InfiniteData } from '{{- reactQueryVersion.packageName -}}';

export function createPaginationOptions<T extends PageableResult<unknown>>() {
  return {
    getPreviousPageParam: ({page } : T) => {
      return page !== 0 ? page - 1 : 0;
    },
    getNextPageParam: ({page, totalPages}:  T) => {
      return page < totalPages - 1 ? page + 1 : {% if reactQueryVersion.name equals "v5" %}null{% else %}undefined{% endif %};
    },
    {% if reactQueryVersion.name equals "v5" %}
    initialPageParam: 0,{% endif %}
  }
}


export function infiniteTotalElements<T>(
  data: InfiniteData<PageableResult<T>>
): number {
  const firstPage = data?.pages?.[0];
  return firstPage ? firstPage.totalElements : 0;
}

