{
  "name": "@rocketbase/commons-rest-client",
  "version": "1.2.0",
  "type": "module",
  "description": "Runtime library for @rocketbase OpenAPI generated TypeScript clients",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "axios": ">=1.7.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/react": "^18.2.0",
    "axios": "^1.7.0",
    "react": "^18.2.0",
    "rollup": "^4.0.0",
    "rollup-plugin-dts": "^6.1.0",
    "tslib": "^2.6.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "keywords": [
    "rocketbase",
    "openapi",
    "typescript",
    "rest-client",
    "react-query"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rocketbase-io/commons-rest.git",
    "directory": "typescript-runtime"
  },
  "license": "MIT",
  "author": "rocketbase.io"
}
